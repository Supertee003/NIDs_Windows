#!/usr/bin/env python3
"""Generate phase1_canonical_reset.ps1 deploy script."""
import os, base64, glob

PHASE1_DIR = '/home/z/my-project/scripts/rewrite/phase1'
OUTPUT_PS1 = '/home/z/my-project/download/phase1_canonical_reset.ps1'

# Find all files to deploy
all_files = []
for root, dirs, files in os.walk(PHASE1_DIR):
    for f in files:
        if f.endswith('.py') or f.endswith('.zig') or f.endswith('.bin') or f.endswith('.md') or f.endswith('.json'):
            full_path = os.path.join(root, f)
            rel_path = os.path.relpath(full_path, PHASE1_DIR)
            all_files.append(rel_path.replace('\\', '/'))

all_files.sort()

deployments = []
for rel_path in all_files:
    src_path = os.path.join(PHASE1_DIR, rel_path)
    with open(src_path, 'rb') as f:
        content = f.read()
    b64 = base64.b64encode(content).decode('ascii')
    deployments.append((rel_path, content.count(b'\n') + 1, b64, os.path.basename(rel_path)))
    print(f"  {rel_path}: {len(content)} bytes")

header = '''# ============================================================
# AEGIS NIDS - Rewrite Phase 1: Canonical Event Reset
# ============================================================
# Changes:
#   1. serializeToBytes()/deserializeFromBytes() = OFFICIAL API
#   2. Legacy serialize()/deserialize() = DEPRECATED (still works)
#   3. @ptrCast/@alignCast only in deprecated path
#   4. 5 cross-language test vectors (109 bytes each)
#
# Migration: Replace all serialize() calls with serializeToBytes()
#             Replace all deserialize() calls with deserializeFromBytes()
# ============================================================
$ErrorActionPreference = 'Continue'
$DeployRoot = $PSScriptRoot
if (-not $DeployRoot) { $DeployRoot = (Get-Location).Path }
Write-Host "[DEPLOY] AEGIS Rewrite Phase 1 - Canonical Event Reset"
Write-Host "[DEPLOY] Deploy root: $DeployRoot"
Write-Host ""

function Deploy-File {
    param([string]$RelativePath, [int]$ExpectedLines, [string]$Base64Content)
    $FullPath = Join-Path $DeployRoot $RelativePath
    $Dir = Split-Path -Parent $FullPath
    if (-not (Test-Path $Dir)) { New-Item -ItemType Directory -Path $Dir -Force | Out-Null }
    $BackupPath = "$FullPath.phase1_backup"
    if (Test-Path $FullPath) { Copy-Item -Path $FullPath -Destination $BackupPath -Force }
    $Bytes = [System.Convert]::FromBase64String($Base64Content)
    [System.IO.File]::WriteAllBytes($FullPath, $Bytes)
    Write-Host "  [OK] $RelativePath"
}

'''

deploy_cmds = []
for i, (rel_path, expected_lines, b64, src_name) in enumerate(deployments, start=1):
    cmd = f'''# File {i}: {rel_path}
$B64_{i} = '{b64}'
Deploy-File -RelativePath "{rel_path}" -Base64Content $B64_{i}
Write-Host ""

'''
    deploy_cmds.append(cmd)

footer = f'''# ============================================================
# Build and test
# ============================================================
Write-Host "[BUILD] Running zig build..."
& zig build 2>&1 | Out-Host
$buildExit = $LASTEXITCODE
if ($buildExit -ne 0) {{ Write-Host "[BUILD] FAILED (exit $buildExit)"; exit 1 }}
Write-Host "[BUILD] SUCCESS"
Write-Host ""

Write-Host "[TEST] Running zig build test..."
& zig build test 2>&1 | Out-Host
$testExit = $LASTEXITCODE
if ($testExit -eq 0) {{
    Write-Host "[TEST] ALL ZIG TESTS PASSED"
}} else {{
    Write-Host "[TEST] FAILED (exit $testExit)"
    exit $testExit
}}
Write-Host ""

Write-Host "[TEST] Generating cross-language test vectors..."
$GenScript = Join-Path $DeployRoot "tests\\contracts\\event_vectors\\generate_test_vectors.py"
if (Test-Path $GenScript) {{
    & python $GenScript 2>&1 | Out-Host
    Write-Host "[TEST] Test vectors generated"
}}
Write-Host ""

Write-Host "============================================================"
Write-Host "REWRITE PHASE 1 COMPLETE: Canonical Event Reset" -ForegroundColor Green
Write-Host "============================================================"
Write-Host ""
Write-Host "Files deployed ({len(deployments)} files):"
Write-Host "  core/canonical_event.zig  (REPLACE)"
Write-Host "    - serializeToBytes/deserializeFromBytes = OFFICIAL API"
Write-Host "    - serialize/deserialize = DEPRECATED (still works, will be removed)"
Write-Host "    - @ptrCast/@alignCast only in deprecated path"
Write-Host "    - 14 tests (8 official + 3 deprecated + 3 offset verification)"
Write-Host ""
Write-Host "  tests/contracts/event_vectors/  (NEW)"
Write-Host "    - event_v1_001.bin: benign forward (192.168.1.100 -> 10.0.0.1:80)"
Write-Host "    - event_v1_002.bin: APT block (192.168.16.16 -> 10.0.0.1:445)"
Write-Host "    - event_v1_003.bin: host event (process start, minifilter)"
Write-Host "    - event_v1_004.bin: edge case (all zeros except magic)"
Write-Host "    - event_v1_005.bin: edge case (all max values 0xFF)"
Write-Host "    - README.md + vectors_metadata.json"
Write-Host "    - generate_test_vectors.py (regeneratable)"
Write-Host ""
Write-Host "Migration status:"
Write-Host "  Step 1.1: serializeToBytes/deserializeFromBytes = OFFICIAL  [DONE]"
Write-Host "  Step 1.2: serialize/deserialize = DEPRECATED              [DONE]"
Write-Host "  Step 1.3: Migrate callers (will be done in Phase 2-5)    [PENDING]"
Write-Host "  Step 1.4: Cross-language test vectors                     [DONE]"
Write-Host ""
Write-Host "============================================================"
Write-Host "Ready for Rewrite Phase 2: Wire ABI" -ForegroundColor Yellow
Write-Host "============================================================"
Write-Host ""
Write-Host "Suggested git commands:"
Write-Host "  git add -A"
Write-Host "  git commit -m `"feat: rewrite phase 1 - canonical event reset`""
Write-Host "  git push"
'''

ps1_content = header + ''.join(deploy_cmds) + footer

with open(OUTPUT_PS1, 'wb') as f:
    f.write(b'\xef\xbb\xbf')
    content = ps1_content.replace('\n', '\r\n')
    f.write(content.encode('utf-8'))

print(f"\nGenerated: {OUTPUT_PS1}")
print(f"Size: {os.path.getsize(OUTPUT_PS1)} bytes")
