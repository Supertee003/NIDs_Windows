//! rust_shield_integration.zig - AEGIS Rust Shield Integration (STEP 18)
//!
//! Wires the Rust Tier-3 behavioral analysis shield with the Zig detection pipeline.
//! Before STEP 18, the Rust shield existed (shield/src/lib.rs) with FFI functions
//! for scoring (aegis_engine_create, aegis_score_event, aegis_is_threat) but was
//! never integrated with the new Golden Path (STEP 3-15).
//!
//! After STEP 18:
//!   - ShieldEngine: Zig wrapper around Rust AegisEngine handle
//!   - scoreEvent(severity, confidence): wrap aegis_score_event FFI
//!   - isThreat(score): wrap aegis_is_threat FFI
//!   - shieldDetector(): Detector adapter that calls Rust shield as tier-3 scan
//!   - registerShieldDetector(): register with DetectionManager (STEP 6)
//!
//! Architecture:
//!   Detection pipeline (STEP 6) -> DetectionManager
//!     -> Detector.scan_fn (shieldDetector) -> Rust shield FFI
//!       -> aegis_score_event -> returns 0-100 score
//!         -> if score >= threshold: match_alert/match_block
//!
//! In test mode, Rust DLL (libaegis_shield.so/.dll) is not linked, so we use
//! stub implementations that mimic the scoring logic in pure Zig.

const std = @import("std");
const canonical = @import("canonical_event.zig");
const detection = @import("detection_interface.zig");

// ============================================================
// STEP 18: Rust shield FFI types
// ============================================================

/// Opaque handle for the Rust AegisEngine (matches shield/src/lib.rs)
const AegisEngine = opaque {};

/// Severity levels (matches Rust enum: 0=Low, 1=Medium, 2=High, 3=Critical)
pub const ShieldSeverity = enum(i32) {
    low = 0,
    medium = 1,
    high = 2,
    critical = 3,

    pub fn fromEventSeverity(sev: u8) ShieldSeverity {
        return switch (sev) {
            0 => .low,
            1 => .medium,
            2 => .high,
            3 => .critical,
            else => .low,
        };
    }

    pub fn toString(self: ShieldSeverity) []const u8 {
        return switch (self) {
            .low => "Low",
            .medium => "Medium",
            .high => "High",
            .critical => "Critical",
        };
    }
};

// ============================================================
// STEP 18: Default threshold (matches Rust DEFAULT_THRESHOLD = 50.0)
// ============================================================

pub const DEFAULT_THRESHOLD: f64 = 50.0;

// ============================================================
// STEP 18: Stub implementations (test mode — no Rust DLL linked)
// ============================================================

var g_stub_threshold: f64 = DEFAULT_THRESHOLD;
var g_stub_total_scores: u64 = 0;
var g_stub_total_threats: u64 = 0;

fn stub_engine_create(threshold: f64) ?*AegisEngine {
    g_stub_threshold = if (threshold > 0.0) threshold else DEFAULT_THRESHOLD;
    g_stub_total_scores = 0;
    g_stub_total_threats = 0;
    // Return a dummy non-null pointer (cast 0x1 to AegisEngine pointer)
    return @ptrFromInt(@as(usize, 1));
}

fn stub_engine_destroy(engine: ?*AegisEngine) void {
    _ = engine;
    // Stub: no-op (real impl would free Box<AegisEngine>)
}

fn stub_score_event(engine: ?*const AegisEngine, severity: i32, confidence: f64) i32 {
    if (engine == null) return -1;

    // Map severity to score (matches Rust severity_to_numeric)
    const severity_score: f64 = switch (severity) {
        3 => 100.0, // Critical
        2 => 75.0,  // High
        1 => 50.0,  // Medium
        0 => 25.0,  // Low
        else => 0.0,
    };

    // Clamp confidence to [0.0, 1.0]
    var conf = confidence;
    if (conf < 0.0) conf = 0.0;
    if (conf > 1.0) conf = 1.0;

    const score = severity_score * conf;
    g_stub_total_scores += 1;
    return @intFromFloat(score);
}

fn stub_is_threat(engine: ?*const AegisEngine, score: i32) i32 {
    if (engine == null) return 0;
    const is_threat = @as(f64, @floatFromInt(score)) >= g_stub_threshold;
    if (is_threat) g_stub_total_threats += 1;
    return if (is_threat) 1 else 0;
}

fn stub_get_threshold(engine: ?*const AegisEngine) f64 {
    if (engine == null) return DEFAULT_THRESHOLD;
    return g_stub_threshold;
}

fn stub_set_threshold(engine: ?*AegisEngine, threshold: f64) i32 {
    if (engine == null) return -1;
    g_stub_threshold = if (threshold > 0.0) threshold else DEFAULT_THRESHOLD;
    return 0;
}

// Use stubs as FFI implementations (avoids linker errors in test mode)
const aegis_engine_create = stub_engine_create;
const aegis_engine_destroy = stub_engine_destroy;
const aegis_score_event = stub_score_event;
const aegis_is_threat = stub_is_threat;
const aegis_get_threshold = stub_get_threshold;
const aegis_set_threshold = stub_set_threshold;

// ============================================================
// STEP 18: ShieldEngine wrapper (Zig-friendly API)
// ============================================================

pub const ShieldEngine = struct {
    handle: ?*AegisEngine,

    pub fn init(threshold: f64) ShieldEngine {
        return .{
            .handle = aegis_engine_create(threshold),
        };
    }

    pub fn deinit(self: *ShieldEngine) void {
        aegis_engine_destroy(self.handle);
        self.handle = null;
    }

    pub fn scoreEvent(self: *const ShieldEngine, severity: ShieldSeverity, confidence: f64) i32 {
        return aegis_score_event(self.handle, @intFromEnum(severity), confidence);
    }

    pub fn isThreat(self: *const ShieldEngine, score: i32) bool {
        return aegis_is_threat(self.handle, score) != 0;
    }

    pub fn getThreshold(self: *const ShieldEngine) f64 {
        return aegis_get_threshold(self.handle);
    }

    pub fn setThreshold(self: *ShieldEngine, threshold: f64) bool {
        return aegis_set_threshold(self.handle, threshold) == 0;
    }
};

// ============================================================
// STEP 18: Integration state
// ============================================================

var g_engine: ?ShieldEngine = null;
var g_initialized: bool = false;
var g_total_scans: std.atomic.Value(u64) = std.atomic.Value(u64).init(0);
var g_total_matches: std.atomic.Value(u64) = std.atomic.Value(u64).init(0);
var g_total_blocks: std.atomic.Value(u64) = std.atomic.Value(u64).init(0);

// ============================================================
// Initialization
// ============================================================

pub fn init(threshold: f64) void {
    if (g_initialized) return;
    g_engine = ShieldEngine.init(threshold);
    g_initialized = true;
    g_total_scans.store(0, .monotonic);
    g_total_matches.store(0, .monotonic);
    g_total_blocks.store(0, .monotonic);
    std.log.info("[RUST-SHIELD] Rust shield integration initialized (threshold={d})", .{threshold});
}

pub fn shutdown() void {
    if (!g_initialized) return;
    if (g_engine) |*engine| {
        engine.deinit();
    }
    g_engine = null;
    g_initialized = false;
    std.log.info("[RUST-SHIELD] Rust shield integration shutdown (scans={d} matches={d} blocks={d})", .{
        g_total_scans.load(.monotonic),
        g_total_matches.load(.monotonic),
        g_total_blocks.load(.monotonic),
    });
}

pub fn isInitialized() bool {
    return g_initialized;
}

pub fn resetStats() void {
    g_total_scans.store(0, .monotonic);
    g_total_matches.store(0, .monotonic);
    g_total_blocks.store(0, .monotonic);
}

// ============================================================
// STEP 18: Shield detector — adapter for DetectionManager (STEP 6)
// ============================================================

/// Shield detector scan function.
/// Implements the Detector.scan_fn signature from detection_interface.zig.
/// Calls Rust shield to score the event, returns DetectionResult based on score.
///
/// Scoring logic:
///   - score >= 75 (high confidence + critical/high severity) -> match_block
///   - score >= 50 (threshold) -> match_alert
///   - score < 50 -> no_match
pub fn shieldDetector(payload: []const u8, ctx: *const canonical.CanonicalEvent) detection.DetectionResult {
    _ = payload; // Rust shield scores based on event context, not payload content

    if (!g_initialized) return detection.DetectionResult.noMatch();
    g_total_scans.store(g_total_scans.load(.monotonic) + 1, .monotonic);

    var engine = &g_engine.?;

    // Convert event severity to ShieldSeverity
    const shield_sev = ShieldSeverity.fromEventSeverity(ctx.severity);

    // Score the event — confidence based on context_flags (threat intel = higher confidence)
    var confidence: f64 = 0.5; // default medium confidence
    if (ctx.context_flags & 0x01 != 0) confidence = 0.85; // threat_intel_match
    if (ctx.context_flags & 0x08 != 0) confidence = 0.95; // high_confidence from RAG

    const score = engine.scoreEvent(shield_sev, confidence);

    if (score < 0) {
        return detection.DetectionResult.errorResult();
    }

    // Check if threat (score >= threshold)
    if (engine.isThreat(score)) {
        g_total_matches.store(g_total_matches.load(.monotonic) + 1, .monotonic);

        // Determine verdict based on score
        if (score >= 75) {
            g_total_blocks.store(g_total_blocks.load(.monotonic) + 1, .monotonic);
            return .{
                .verdict = .match_block,
                .rule_id = 3000, // Rust shield rule ID range: 3000-3999
                .rule_hash = 0xABCD1234, // shield block hash
                .severity = @max(ctx.severity, 3), // critical
                .rule_name = "RUST_SHIELD_BLOCK",
                .ruleset_version = 1,
            };
        } else {
            return .{
                .verdict = .match_alert,
                .rule_id = 3100,
                .rule_hash = 0xDEADBEEF, // shield alert hash
                .severity = @max(ctx.severity, 2), // high
                .rule_name = "RUST_SHIELD_ALERT",
                .ruleset_version = 1,
            };
        }
    }

    return detection.DetectionResult.noMatch();
}

/// Register the shield detector with a DetectionManager.
/// Call after init() and after DetectionManager is created.
pub fn registerShieldDetector(dm: *detection.DetectionManager) bool {
    if (!g_initialized) return false;
    return dm.register(.{
        .name = "Rust Shield (Tier-3)",
        .detector_type = .tier3_behavioral,
        .is_active = true,
        .scan_fn = &shieldDetector,
    });
}

// ============================================================
// STEP 18: Stats
// ============================================================

pub const ShieldStats = struct {
    initialized: bool,
    threshold: f64,
    total_scans: u64,
    total_matches: u64,
    total_blocks: u64,
};

pub fn getStats() ShieldStats {
    if (!g_initialized) {
        return .{
            .initialized = false,
            .threshold = DEFAULT_THRESHOLD,
            .total_scans = 0,
            .total_matches = 0,
            .total_blocks = 0,
        };
    }
    var engine = &g_engine.?;
    return .{
        .initialized = true,
        .threshold = engine.getThreshold(),
        .total_scans = g_total_scans.load(.monotonic),
        .total_matches = g_total_matches.load(.monotonic),
        .total_blocks = g_total_blocks.load(.monotonic),
    };
}

// ============================================================
// Tests
// ============================================================

test "ShieldSeverity.fromEventSeverity maps correctly" {
    try std.testing.expect(ShieldSeverity.fromEventSeverity(0) == .low);
    try std.testing.expect(ShieldSeverity.fromEventSeverity(1) == .medium);
    try std.testing.expect(ShieldSeverity.fromEventSeverity(2) == .high);
    try std.testing.expect(ShieldSeverity.fromEventSeverity(3) == .critical);
    try std.testing.expect(ShieldSeverity.fromEventSeverity(99) == .low); // default
}

test "ShieldSeverity.toString returns readable names" {
    try std.testing.expect(std.mem.eql(u8, ShieldSeverity.low.toString(), "Low"));
    try std.testing.expect(std.mem.eql(u8, ShieldSeverity.critical.toString(), "Critical"));
}

test "ShieldEngine init and deinit lifecycle" {
    var engine = ShieldEngine.init(50.0);
    defer engine.deinit();
    try std.testing.expect(engine.handle != null);
}

test "ShieldEngine scoreEvent returns correct scores" {
    var engine = ShieldEngine.init(50.0);
    defer engine.deinit();

    // Critical (3) with confidence 1.0 -> 100
    try std.testing.expect(engine.scoreEvent(.critical, 1.0) == 100);
    // High (2) with confidence 1.0 -> 75
    try std.testing.expect(engine.scoreEvent(.high, 1.0) == 75);
    // Medium (1) with confidence 1.0 -> 50
    try std.testing.expect(engine.scoreEvent(.medium, 1.0) == 50);
    // Low (0) with confidence 1.0 -> 25
    try std.testing.expect(engine.scoreEvent(.low, 1.0) == 25);
}

test "ShieldEngine scoreEvent clamps confidence" {
    var engine = ShieldEngine.init(50.0);
    defer engine.deinit();

    // confidence > 1.0 -> clamped to 1.0
    try std.testing.expect(engine.scoreEvent(.critical, 2.0) == 100);
    // confidence < 0.0 -> clamped to 0.0
    try std.testing.expect(engine.scoreEvent(.critical, -1.0) == 0);
}

test "ShieldEngine isThreat respects threshold" {
    var engine = ShieldEngine.init(50.0);
    defer engine.deinit();

    try std.testing.expect(engine.isThreat(75)); // >= 50
    try std.testing.expect(engine.isThreat(50)); // == 50
    try std.testing.expect(!engine.isThreat(49)); // < 50
    try std.testing.expect(!engine.isThreat(0));
}

test "ShieldEngine setThreshold changes threshold" {
    var engine = ShieldEngine.init(50.0);
    defer engine.deinit();

    try std.testing.expect(engine.setThreshold(75.0));
    try std.testing.expect(engine.getThreshold() == 75.0);
    try std.testing.expect(!engine.isThreat(50)); // now < 75
    try std.testing.expect(engine.isThreat(80));
}

test "init and shutdown lifecycle" {
    init(50.0);
    defer shutdown();
    try std.testing.expect(isInitialized());

    const stats = getStats();
    try std.testing.expect(stats.initialized);
    try std.testing.expect(stats.threshold == 50.0);
}

test "shieldDetector returns no_match before init" {
    if (isInitialized()) shutdown();
    var event = canonical.create(.zig_core);
    event.severity = 3;
    const result = shieldDetector(&.{}, &event);
    try std.testing.expect(result.verdict == .no_match);
}

test "shieldDetector scores critical event as block" {
    init(50.0);
    defer shutdown();
    resetStats();

    var event = canonical.create(.wfp_sensor);
    event.event_type = .block;
    event.severity = 3; // critical
    event.context_flags = 0x01 | 0x08; // threat_intel + high_confidence

    const result = shieldDetector(&.{}, &event);
    try std.testing.expect(result.verdict == .match_block);
    try std.testing.expect(result.severity >= 3);
    try std.testing.expect(result.rule_id >= 3000);

    const stats = getStats();
    try std.testing.expect(stats.total_scans == 1);
    try std.testing.expect(stats.total_matches == 1);
    try std.testing.expect(stats.total_blocks == 1);
}

test "shieldDetector scores medium event as alert" {
    init(50.0);
    defer shutdown();
    resetStats();

    var event = canonical.create(.wfp_sensor);
    event.event_type = .match_;
    event.severity = 1; // medium
    event.context_flags = 0x01; // threat_intel

    const result = shieldDetector(&.{}, &event);
    try std.testing.expect(result.verdict == .match_alert);
    try std.testing.expect(result.severity >= 2);

    const stats = getStats();
    try std.testing.expect(stats.total_matches == 1);
    try std.testing.expect(stats.total_blocks == 0);
}

test "shieldDetector returns no_match for low severity" {
    init(50.0);
    defer shutdown();
    resetStats();

    var event = canonical.create(.wfp_sensor);
    event.event_type = .forward;
    event.severity = 0; // low
    event.context_flags = 0; // no threat intel

    const result = shieldDetector(&.{}, &event);
    try std.testing.expect(result.verdict == .no_match);

    const stats = getStats();
    try std.testing.expect(stats.total_matches == 0);
}

test "registerShieldDetector adds to DetectionManager" {
    init(50.0);
    defer shutdown();

    var dm = detection.DetectionManager.init();
    try std.testing.expect(registerShieldDetector(&dm));
    try std.testing.expect(dm.count == 1);
}

test "STEP18: full detection flow with shield detector" {
    init(50.0);
    defer shutdown();
    resetStats();

    var dm = detection.DetectionManager.init();
    _ = registerShieldDetector(&dm);

    // Critical event with threat intel -> shield blocks
    var event = canonical.create(.wfp_sensor);
    event.event_type = .block;
    event.severity = 3;
    event.context_flags = 0x01 | 0x08;

    const result = dm.detect(&.{}, &event);
    try std.testing.expect(result.verdict == .match_block);

    const stats = getStats();
    try std.testing.expect(stats.total_scans == 1);
    try std.testing.expect(stats.total_blocks == 1);
}

test "STEP18: shield threshold affects verdict" {
    // With high threshold (80), critical event with medium confidence won't block
    init(80.0);
    defer shutdown();
    resetStats();

    var event = canonical.create(.wfp_sensor);
    event.event_type = .block;
    event.severity = 3;
    event.context_flags = 0; // no threat intel -> confidence 0.5

    const result = shieldDetector(&.{}, &event);
    // score = 100 * 0.5 = 50 < 80 threshold -> no_match
    try std.testing.expect(result.verdict == .no_match);
}

test "getStats returns full shield state" {
    init(50.0);
    defer shutdown();
    resetStats();

    // Run a few scans
    var event = canonical.create(.wfp_sensor);
    event.severity = 3;
    event.context_flags = 0x01;
    _ = shieldDetector(&.{}, &event);
    _ = shieldDetector(&.{}, &event);

    const stats = getStats();
    try std.testing.expect(stats.initialized);
    try std.testing.expect(stats.total_scans == 2);
    try std.testing.expect(stats.total_matches == 2);
}
