//! stress_test.zig - AEGIS Stress Test (STEP 24)
//!
//! Sustained load tests verifying pipeline stability under high event volume:
//!   1. 1000+ events single-thread sustained throughput
//!   2. Multi-thread concurrent submission (4 threads x 250 events)
//!   3. Memory stability (no exponential growth under load)
//!   4. Queue overflow handling (fill to capacity + verify drops)
//!   5. Mixed event types (block/alert/forward interleaved)
//!   6. Long-running session (simulate 5-minute burst in compressed time)
//!
//! These tests verify that the pipeline doesn't crash, leak memory,
//! or produce inconsistent results under production-like load.

const std = @import("std");
const canonical = @import("canonical_event.zig");
const nose = @import("nose_contract.zig");
const nose_int = @import("nose_integration.zig");
const fabric = @import("event_fabric.zig");
const flow_int = @import("flow_integration.zig");
const detection_int = @import("detection_integration.zig");
const correlation_int = @import("correlation_integration.zig");
const rag_int = @import("rag_integration.zig");
const policy_int = @import("policy_integration.zig");
const forensics_int = @import("forensics_integration.zig");

// ============================================================
// Helpers
// ============================================================

fn initAllLayers() void {
    nose.initFabric(std.testing.allocator, .{ .capacity_per_priority = 1024 }) catch {};
    nose_int.init(.{ .seed = 42 });
    flow_int.init();
    detection_int.init(detection_int.EscalationThresholds.default());
    correlation_int.init();
    rag_int.init();
    policy_int.init();
    forensics_int.init();
}

fn shutdownAllLayers() void {
    forensics_int.shutdown();
    policy_int.shutdown();
    rag_int.shutdown();
    correlation_int.shutdown();
    flow_int.shutdown();
    nose_int.resetStats();
    nose.shutdownFabric(std.testing.allocator);
}

fn resetAllStats() void {
    nose_int.resetStats();
    detection_int.resetStats();
    correlation_int.resetStats();
    rag_int.resetStats();
    policy_int.resetStats();
    forensics_int.resetStats();
}

fn makeEvent(seq: u64) canonical.CanonicalEvent {
    var event = canonical.create(.wfp_sensor);
    event.event_type = .forward;
    event.source_ip = 0xC0A80202 + @as(u32, @intCast(seq & 0xFF));
    event.dest_ip = 0x0A000001;
    event.source_port = @as(u16, @intCast(10000 + (seq & 0xFFFF)));
    event.dest_port = 80;
    event.protocol = 6;
    event.payload_length = 100;
    event.is_pipe = 0;
    event.session_id = seq;
    return event;
}

// ============================================================
// Test 1: 1000 events single-thread sustained
// ============================================================

test "STEP24: 1000 events sustained throughput (single-thread)" {
    initAllLayers();
    defer shutdownAllLayers();
    resetAllStats();

    const count: u64 = 1000;
    var i: u64 = 0;
    while (i < count) : (i += 1) {
        const event = makeEvent(i);
        const result = policy_int.processEventFullPipeline(event, null, &.{});
        forensics_int.logPipelineResult(result);
    }

    // Verify all events processed
    const forensic_stats = forensics_int.getStats();
    try std.testing.expect(forensic_stats.total_records == count);

    // Verify flow engine has flows (unique source IPs)
    const flow_stats = flow_int.getStats();
    try std.testing.expect(flow_stats.total_events_processed == count);

    // Verify correlation created incidents
    const corr_stats = correlation_int.getStats();
    try std.testing.expect(corr_stats.total_submissions == count);

    // Verify RAG enriched all
    const rag_stats = rag_int.getStats();
    try std.testing.expect(rag_stats.total_enriched == count);

    // Verify policy evaluated all
    const policy_stats = policy_int.getStats();
    try std.testing.expect(policy_stats.total_evaluations == count);
}

// ============================================================
// Test 2: Multi-thread concurrent submission
// ============================================================

const StressContext = struct {
    thread_id: u32,
    event_count: u32,
    errors: *u64,
};

fn stressWorker(ctx: StressContext) void {
    var i: u32 = 0;
    while (i < ctx.event_count) : (i += 1) {
        var event = canonical.create(.wfp_sensor);
        event.event_type = .forward;
        event.source_ip = 0xC0A80000 + ctx.thread_id;
        event.dest_ip = 0x0A000001;
        event.source_port = @as(u16, @intCast(ctx.thread_id * 100 + i));
        event.dest_port = 80;
        event.protocol = 6;
        event.payload_length = 64;
        event.is_pipe = 0;
        event.session_id = @as(u64, ctx.thread_id) * 10000 + i;

        const result = nose_int.submit(event);
        if (result != .accepted and result != .dropped_at_source and result != .dropped_by_fabric) {
            _ = @atomicRmw(u64, ctx.errors, .Add, 1, .monotonic);
        }
    }
}

test "STEP24: multi-thread concurrent submission (4 threads x 250)" {
    initAllLayers();
    defer shutdownAllLayers();
    resetAllStats();

    const num_threads: u32 = 4;
    const events_per_thread: u32 = 250;
    var errors: u64 = 0;

    var threads: [4]std.Thread = undefined;
    var i: u32 = 0;
    while (i < num_threads) : (i += 1) {
        threads[i] = std.Thread.spawn(.{}, stressWorker, .{.{
            .thread_id = i + 1,
            .event_count = events_per_thread,
            .errors = &errors,
        }}) catch {
            errors += 1;
            continue;
        };
    }

    for (threads) |t| t.join();

    try std.testing.expect(errors == 0);

    // Note: nose_int uses global state that may have been modified by prior tests.
    // Verify at least our submissions were attempted (>= because other tests may have added).
    const stats = nose_int.getStats();
    try std.testing.expect(stats.total_submits >= num_threads * events_per_thread);
    // Verify all our events were either accepted or dropped (no errors)
    try std.testing.expect(stats.accepted + stats.dropped_at_source + stats.dropped_by_fabric >= num_threads * events_per_thread);
}

// ============================================================
// Test 3: Memory stability (ring buffer doesn't overflow)
// ============================================================

test "STEP24: forensics ring buffer handles overflow gracefully" {
    initAllLayers();
    defer shutdownAllLayers();
    resetAllStats();

    // Write more events than ring capacity (4096)
    const count: u64 = 5000;
    var i: u64 = 0;
    while (i < count) : (i += 1) {
        const event = makeEvent(i);
        const result = policy_int.processEventFullPipeline(event, null, &.{});
        forensics_int.logPipelineResult(result);
    }

    // Ring should have at most 4096 entries (oldest evicted)
    const stats = forensics_int.getStats();
    try std.testing.expect(stats.total_records == count); // total counted
    try std.testing.expect(stats.ring_used <= 4096); // ring capped
    try std.testing.expect(stats.ring_used > 0); // some entries present
}

// ============================================================
// Test 4: Queue overflow handling
// ============================================================

test "STEP24: queue overflow drops events gracefully" {
    initAllLayers();
    defer shutdownAllLayers();

    // Use small capacity to trigger overflow
    nose.shutdownFabric(std.testing.allocator);
    nose.initFabric(std.testing.allocator, .{ .capacity_per_priority = 8 }) catch {};
    nose_int.init(.{
        .seed = 42,
        .high_drop_low = false,
        .saturated_drop_low_and_normal = false,
        .medium_low_drop_fraction = 0.0,
    });
    resetAllStats();

    // Submit 100 events — most should be dropped
    var i: u64 = 0;
    while (i < 100) : (i += 1) {
        var event = makeEvent(i);
        event.event_type = .block; // all HIGH priority
        _ = nose_int.submit(event);
    }

    // Should have accepted 8 + dropped the rest
    const stats = nose_int.getStats();
    try std.testing.expect(stats.total_submits == 100);
    try std.testing.expect(stats.accepted <= 8);
    try std.testing.expect(stats.dropped_by_fabric > 0);
}

// ============================================================
// Test 5: Mixed event types interleaved
// ============================================================

test "STEP24: mixed event types (block/alert/forward) interleaved" {
    initAllLayers();
    defer shutdownAllLayers();
    resetAllStats();

    const event_types = [_]canonical.EventType{ .block, .match_, .forward, .forward, .block, .forward };
    var i: u64 = 0;
    while (i < 600) : (i += 1) {
        var event = makeEvent(i);
        event.event_type = event_types[i % event_types.len];
        event.severity = switch (event.event_type) {
            .block => 3,
            .match_ => 2,
            .forward => 0,
            else => 0,
        };
        const result = policy_int.processEventFullPipeline(event, null, &.{});
        forensics_int.logPipelineResult(result);
    }

    const stats = forensics_int.getStats();
    try std.testing.expect(stats.total_records == 600);

    // Verify some events triggered BLOCK decisions
    const policy_stats = policy_int.getStats();
    try std.testing.expect(policy_stats.total_blocks > 0); // block events
    try std.testing.expect(policy_stats.total_alerts > 0); // match_ events
}

// ============================================================
// Test 6: Long-running session (compressed 5-minute burst)
// ============================================================

test "STEP24: long-running burst (2000 events, no crash)" {
    initAllLayers();
    defer shutdownAllLayers();
    resetAllStats();

    const count: u64 = 2000;
    var i: u64 = 0;
    while (i < count) : (i += 1) {
        var event = makeEvent(i);
        // Vary severity to test different paths
        event.severity = @intCast(i % 4);
        const result = policy_int.processEventFullPipeline(event, null, &.{});
        forensics_int.logPipelineResult(result);

        // Periodically drain queue (simulate eventFabricDrain)
        if (i % 100 == 0) {
            while (fabric.popEvent()) |_| {}
        }
    }

    // Pipeline should complete without crash
    const forensic_stats = forensics_int.getStats();
    try std.testing.expect(forensic_stats.total_records == count);

    // Ring should be within capacity
    try std.testing.expect(forensic_stats.ring_used <= 4096);
}

