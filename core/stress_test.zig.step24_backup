// ============================================================
// Test 8: No memory leak under repeated init/shutdown cycles
// ============================================================

test "STEP24: repeated init/shutdown cycles don't crash (3 cycles)" {
    var cycle: u32 = 0;
    while (cycle < 3) : (cycle += 1) {
        initAllLayers();
        resetAllStats();

        // Process some events
        var i: u64 = 0;
        while (i < 50) : (i += 1) {
            const event = makeEvent(i + @as(u64, cycle) * 50);
            const result = policy_int.processEventFullPipeline(event, null, &.{});
            forensics_int.logPipelineResult(result);
        }

        // Verify each cycle processed
        const stats = forensics_int.getStats();
        try std.testing.expect(stats.total_records == 50);

        shutdownAllLayers();
    }

    // If we got here without crash, memory is stable
    try std.testing.expect(true);
}

