// Test 9: Forensics query under load
// ============================================================

test "STEP24: forensics query works after heavy load" {
    initAllLayers();
    defer shutdownAllLayers();
    resetAllStats();

    // Fill with 1000 events
    var i: u64 = 0;
    while (i < 1000) : (i += 1) {
        const event = makeEvent(i);
        const result = policy_int.processEventFullPipeline(event, null, &.{});
        forensics_int.logPipelineResult(result);
    }

    // Query by session_id
    const query_result = forensics_int.query(.{ .session_id = 500 });
