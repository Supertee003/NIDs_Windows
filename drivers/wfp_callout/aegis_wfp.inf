; aegis_wfp.inf — AEGIS NIDS WFP Callout Driver Installation INF
; Primitive/software-only driver package. Install with:
;   pnputil /add-driver aegis_wfp.inf /install
; Requires: Test Signing enabled (bcdedit /set testsigning on)

[Version]
Signature   = $Windows NT$
Class       = System
ClassGuid   = {78A1C341-4539-11D3-B88D-00C04FAD5171}
Provider    = %ProviderString%
DriverVer   = 07/14/2026,1.0.0
CatalogFile = aegis_wfp.cat

[Manufacturer]
%MfgName% = Standard,NTamd64

[Standard.NTamd64]
%DevDesc% = AegisWfp_Install, Root\AEGIS_WFP

[DestinationDirs]
DefaultDestDir = 12 ; Winnt\System32\drivers
AegisWfp.DriverFiles = 12

[SourceDisksNames]
1 = %DiskName%,,

[SourceDisksFiles]
aegis_wfp.sys = 1

[DefaultInstall]
CopyFiles = AegisWfp.DriverFiles

[DefaultInstall.Services]
AddService = AegisWfp,, AegisWfp_Service

[AegisWfp_Install]
Include = machine.inf
Needs   = SoftwareDeviceRegistration
CopyFiles = AegisWfp.DriverFiles

[AegisWfp_Install.Services]
AddService = AegisWfp,, AegisWfp_Service

[AegisWfp.DriverFiles]
aegis_wfp.sys,,,2

[AegisWfp_Service]
DisplayName    = %ServiceDesc%
ServiceType    = 1       ; SERVICE_KERNEL_DRIVER
StartType      = 3       ; SERVICE_DEMAND_START
ErrorControl   = 1       ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\aegis_wfp.sys
AddReg         = AegisWfp_Params

[AegisWfp_Params]
HKR, "Parameters", "RingBufferSize", 0x00010001, 2097152  ; 2MB

[Strings]
ProviderString     = "AEGIS NIDS Project"
MfgName            = "AEGIS"
ManufacturerName   = "AEGIS"
DiskName           = "AEGIS WFP Callout Driver Installation Disk"
ServiceDesc        = "AEGIS NIDS WFP Callout Driver"
DevDesc            = "AEGIS NIDS WFP Callout Driver"
