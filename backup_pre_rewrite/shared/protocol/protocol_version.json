{
  "protocol_name": "AEGIS Wire Protocol",
  "version": 1,
  "magic": "0x57455631",
  "endian": "little",
  "header_size": 16,
  "max_payload": 65536,
  "payload_types": {
    "0": "canonical_event",
    "1": "command",
    "2": "ack",
    "3": "heartbeat"
  },
  "canonical_event_version": 1,
  "canonical_event_magic": "0x41454731",
  "timestamp_fields": {
    "timestamp_ms": "u64",
    "monotonic_ns": "u64"
  },
  "step1_changes": [
    "timestamp_ms: i64 → u64 (no negative timestamps)",
    "monotonic_ns: i128 → u64 (i128 not portable across languages)",
    "Explicit field-by-field encoding (no memcpy of struct)",
    "CRC32 integrity check on payload"
  ]
}
