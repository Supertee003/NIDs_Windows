# All text files use LF line endings so build_manifest.json SHA256
# digests stay stable across platforms (core.autocrlf true on Windows
# CI would otherwise flip to CRLF and break the verify gate).
* text=auto eol=lf

# Installer scripts are generated by tools/installer.py with LF endings;
# keep them LF in the working tree so recorded digests stay stable across
# regeneration (core.autocrlf true would otherwise flip them to CRLF and
# break the build-manifest drift gate).
installer/*.nsi text eol=lf
scripts/verify_release.ps1 text eol=lf