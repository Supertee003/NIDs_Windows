+func calculateDEFCON(stats ThreatStats) DefconLevel {
+	if stats.CriticalCount >= 10 || stats.BlockedCount >= 5 || stats.KernelThreats >= 3 {
+		return DEFCON_1_MAXIMUM
+	}
+	if stats.CriticalCount >= 5 || stats.BlockedCount >= 3 {
