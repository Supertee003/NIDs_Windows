+            policy = r.get("action", "Alert").upper()
+            severity_str = r.get("severity", "Medium")
+            severity_map = {"Low": 0, "Medium": 1, "High": 2, "Critical": 3}
+            severity = severity_map.get(severity_str, 1)
+            return (name, policy, rule_id, severity)
+
+    return None
