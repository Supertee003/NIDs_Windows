# Build artifacts
zig-out/
.zig-cache/
zig-cache/
target/
shield/target/
aegis_dashboard/target/
aegis_dashboard/.cargo/
build/
dist/
*.exe
*.dll
*.lib
*.obj
*.pdb
*.sys
*.exp
*.ilk
*.rlib
*.rmeta
*.d
*.timestamp

# Backup / snapshot artifacts (untracked at T1; keep on disk only)
backup_*/
backups/
*.bak.*
*.g58_backup
*.phase16_backup
*.phase20_backup
*.phase21_backup

# Stale duplicate crate (untracked at T1, preserved on disk for reference)
shield_rust/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Cython / native extensions (generated by setup.py build_ext --inplace)
# Source .pyx/.pxd are committed; generated C and .pyd/.so are not.
*.pyd
*.so
# Generated C from Cython (mirror of .pyx)
brain/aegis_brain_cython/*.c
brain/cython/*.c
brain/cython/build/
brain/aegis_brain_cython/build/

# TypeScript / Node (ts_policy/)
ts_policy/node_modules/
ts_policy/dist/
ts_policy/*.tsbuildinfo

# Rust (shield/)
shield/target/
shield/Cargo.lock
# Generated Rust deps (use cargo to regenerate)
**/Cargo.lock
# Rust build artifacts that are regenerable
*.rlib
*.rmeta
*.d
*.timestamp

# Driver binaries (generated by WDK build)
*.sys
*.inf

# Logs and snapshots
logs/
*.log
*.ndjson
logs/snapshots/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Configs with secrets
.env
.env.local
configs/secrets/*.key
configs/secrets/*.pem
configs/secrets/*.pfx

# Package
*.msi
*.nupkg
*.snap

# Query tool temp file
query
