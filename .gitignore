# =====================================================================
# AEGIS NIDS — .gitignore
# =====================================================================
# Per ADR-RUNTIME-CONVERGENCE and BLOCKER C of the Deep Remediation Report,
# NO build artifacts, caches, or runtime state may be tracked in git.
# =====================================================================

# --- Rust build output ---
target/
**/*.rs.bk
*.rcgu.o
*.rcgu.*

# --- Zig build output ---
zig-out/
.zig-cache/

# --- Compiled binaries (build artifacts) ---
*.exe
*.dll
*.pdb
*.obj
*.lib
*.exp
*.so
*.dylib
*.ilk

# --- Driver build artifacts ---
*.sys
*.cat
*.cer
*.inf.bak

# --- C++ build output ---
build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.cmake

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.venv/
venv/
.mypy_cache/
.ruff_cache/

# --- Cython generated C ---
brain/cython/*.c
brain/cython/*.so
brain/cython/*.pyd

# --- Go ---
*.test
*.out

# --- Distribution artifacts ---
dist/
*.zip
*.tar.gz
*.7z

# --- Runtime state (NEVER track) ---
logs/
*.pid
*.lock
*.log
config/threat_graph.html
aegis_threat_map.html

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Secrets / local config ---
.env
.env.local
configs/secrets/
*.key
*.pem
*.pfx

# --- Backups ---
backup_*/
backups/
*.bak
*.bak.*

# --- Vendored cache (keep source under lib/) ---
node_modules/