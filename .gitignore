*.bak
*.bak.*
*.g58_backup
*.phase*_backup

# Legacy core/ folder kept in git per request (original development work)
# NOT part of production build (build.zig uses src/main.zig)
# core/
release/T20-final/
shield_rust/
lib/
models/ml_model.json
nids_main.zig
nids_analyze.zig
AEGIS_v5_fresh_deploy.ps1
aegis_restore.bat
aegis_restore.ps1.bak.*
