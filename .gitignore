# =====================================================================
# AEGIS NIDS — .gitignore
# =====================================================================
# Per ADR-RUNTIME-CONVERGENCE and BLOCKER C of the Deep Remediation Report,
# NO build artifacts, caches, or runtime state may be tracked in git.
# =====================================================================

# --- Rust build output ---
target/
**/*.rs.bk
*.rcgu.o
*.rcgu.*

# --- Zig build output ---
zig-out/
.zig-cache/

# --- Compiled binaries (build artifacts) ---
*.exe
*.dll
*.pdb
*.obj
*.lib
*.exp
*.so
*.dylib
*.ilk

# --- Driver build artifacts ---
*.sys
*.cat
*.cer
*.inf.bak

# --- C++ build output ---
build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.cmake

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.venv/
venv/
.mypy_cache/
.ruff_cache/

# --- Cython generated C ---
brain/cython/*.c
brain/cython/*.so
brain/cython/*.pyd

# --- Go ---
*.test
*.out

# --- Distribution artifacts ---
dist/
*.zip
*.tar.gz
*.7z

# --- Runtime state (NEVER track) ---
logs/
*.pid
*.lock
*.log
config/threat_graph.html
aegis_threat_map.html

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Secrets / local config ---
.env
.env.local
configs/secrets/
configs/cluster.json
configs/policy_trust.json
configs/disabled_rules.json
*.key
*.pem
*.pfx

# --- Backups ---
backup_*/
backups/
*.bak
*.bak.*

# --- Vendored cache (keep source under lib/) ---
node_modules/
# --- VM test kit output (generated handoff bundles) ---
vm_test_kit_*/

# --- Phase 8 Lab Evidence (runtime artifacts, not part of core repo) ---
evidence/phase8-lab-*/
# --- Kali attack simulation scripts ---
scripts/kali_attacks/
scripts/gen_kali_22.py
scripts/kali_attack_nids.py
# --- Admin evidence (runtime state) ---
# Per-run gate receipts, probes, and audits land here (see README Project 2
# Runtime Gate). Never tracked; EVIDENCE_INDEX.json is the committed index.
admin-evidence/
# --- Generated reports / scratch (runtime artifacts, not part of core repo) ---
reports/
tmp_hbc/
# --- NSIS installer outputs (generated by tools/installer.py --package/--generate) ---
installer.generated.nsi
aegis-installer-*.exe
aegis_setup.exe
