# AEGIS NIDS .gitignore

# Zig build artifacts
zig-cache/
zig-out/
*.exe
*.pdb
*.ilk
*.obj

# Rust build artifacts
target/
**/*.rs.bk

# Go build artifacts
*.exe
*.test
*.out

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Backup directories (NEVER commit these)
backup_phase*/
backup_hotfix*/
backup_pre_rewrite/
backup_g*/
backup_*/

# Logs
logs/
*.log
*.ndjson
*.ndjson.*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets (never commit credentials)
.env
.env.local
secrets/
*.key
*.pem
*.p12

# Kernel driver build artifacts
drivers/**/*.sys
drivers/**/*.inf
drivers/**/*.cat

# CMake build artifacts (C++ bridge)
cmake-build-*/
CMakeFiles/
cmake_install.cmake
Makefile

# Build cache (with dot)
.zig-cache/

# Backup files
*.bak
*_backup
**/*_backup

# Build logs
build_*.txt
verify_build.*

# Stray root files
threat_graph.html
IDEA.md

# G42 cleanup: ensure backup files are ignored
*.bak_*
*.phase*_backup
*.phase*backup
brain/aegis_brain_cython/fast_scan.c
brain/aegis_brain_cython/*.c


# G43 audit additions
*.pyc
logs/pids/
*.dll
*.o
*.exp
*.lib
.pytest_cache/
